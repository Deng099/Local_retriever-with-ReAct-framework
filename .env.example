OPENAI_MODEL=your-generation-model
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://your-generation-provider.example/v1
OPENAI_API_TYPE=chat
OPENAI_TRUST_ENV=true
RETRIEVER_BASE_URL=http://127.0.0.1:8002
RETRIEVER_API_KEY=replace-with-a-private-random-token

# A local directory is recommended on the shared server. A Hugging Face model ID
# also works, but then Transformers chooses the cache location.
EMBEDDING_MODEL_PATH=/data00/xingyi_deng/models/Qwen3-Embedding-0.6B
# EMBEDDING_DEVICE=cuda:0

# Visit extraction reuses the generation settings above by default.
# VISIT_EXTRACTION_ENABLED=0
# VISIT_EXTRACTION_MODEL=your-separate-extraction-model
# VISIT_EXTRACTION_API_KEY=your-separate-api-key
# VISIT_EXTRACTION_BASE_URL=https://your-extraction-provider.example/v1
# VISIT_EXTRACTION_TRUST_ENV=false
# VISIT_EXTRACTION_MAX_INPUT_CHARS=12000
# VISIT_EXTRACTION_MAX_OUTPUT_CHARS=6000
